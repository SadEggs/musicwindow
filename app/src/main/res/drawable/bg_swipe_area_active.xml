<?xml version="1.0" encoding="utf-8"?>
<!-- The swipe zone while a swipe is in progress: same outline, lit up. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#1A4FC3F7" />

    <stroke
        android:width="1dp"
        android:color="#B34FC3F7" />

    <corners android:radius="8dp" />

</shape>
