<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque dark background. Transparency is controlled by View.setAlpha(),
     so the "% opacity" settings map directly to what you see on screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#FF12161C" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
